--- !u!114 &1209869203
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1209869201}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This is a simulation we created that can be used by the medical industry
    to research\nthe affects that different diseases may have on people. It can be
    used to find out \nthe number of casualties that may occur in a given area depending
    not only on \nthe severity of the disease but also on how close people may come
    into contact with \neach other and how many hospitals (or centers that can provide
    medication or \nvaccines) are in the area. Disclosure - This is just a simple
    simulation and the data\ndisplayed may not be accurate.  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
